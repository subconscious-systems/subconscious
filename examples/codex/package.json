{
  "name": "codex-subconscious",
  "version": "0.1.0",
  "displayName": "Codex + Subconscious",
  "description": "Run Codex on your hosted Subconscious model using the ol-runbook provider, model catalog, and compaction hooks.",
  "subconscious": {
    "language": "shell",
    "framework": "Codex",
    "category": "coding-agent",
    "tags": [
      "local",
      "cli",
      "agents"
    ],
    "envVars": {
      "SUBCONSCIOUS_API_KEY": {
        "required": true,
        "url": "https://subconscious.dev/platform"
      }
    },
    "agent": {
      "id": "codex",
      "name": "Codex CLI",
      "protocol": "openai",
      "install": "npm i -g @openai/codex",
      "launch": "codex -c model=subconscious/glm-5.2 -c model_provider=subconscious -c web_search=disabled -c model_providers.subconscious.name=Subconscious -c model_providers.subconscious.base_url=https://api-dev.subconscious.dev/v1 -c model_providers.subconscious.wire_api=responses -c model_providers.subconscious.env_key=SUBCONSCIOUS_API_KEY -c model_providers.subconscious.stream_idle_timeout_ms=300000",
      "env": {
        "SUBCONSCIOUS_API_KEY": "your_key",
        "SUBCONSCIOUS_GATEWAY_URL": "https://api-dev.subconscious.dev"
      }
    }
  },
  "setup": [
    "export SUBCONSCIOUS_API_KEY=your_key",
    "export SUBCONSCIOUS_GATEWAY_URL=https://api-dev.subconscious.dev",
    "codex -c model=subconscious/glm-5.2 -c model_provider=subconscious -c web_search=disabled -c model_providers.subconscious.name=Subconscious -c model_providers.subconscious.base_url=https://api-dev.subconscious.dev/v1 -c model_providers.subconscious.wire_api=responses -c model_providers.subconscious.env_key=SUBCONSCIOUS_API_KEY -c model_providers.subconscious.stream_idle_timeout_ms=300000"
  ]
}
