{
  "name": "claude-code-subconscious",
  "version": "0.1.0",
  "displayName": "Claude Code + Subconscious",
  "description": "Run Claude Code on your hosted Subconscious model using the ol-runbook environment and telemetry setup.",
  "subconscious": {
    "language": "shell",
    "framework": "Claude Code",
    "category": "coding-agent",
    "tags": [
      "local",
      "cli",
      "agents"
    ],
    "envVars": {
      "SUBCONSCIOUS_API_KEY": {
        "required": true,
        "url": "https://subconscious.dev/platform"
      }
    },
    "agent": {
      "id": "claude-code",
      "name": "Claude Code",
      "protocol": "anthropic",
      "install": "curl -fsSL https://claude.ai/install.sh | bash",
      "launch": "claude",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.subconscious.dev",
        "ANTHROPIC_AUTH_TOKEN": "your_key",
        "ANTHROPIC_MODEL": "subconscious/glm-5.2",
        "ANTHROPIC_SMALL_FAST_MODEL": "subconscious/glm-5.2",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "subconscious/glm-5.2",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "subconscious/glm-5.2",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Subconscious default model",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "subconscious/tim-qwen3.6-27b",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "subconscious/tim-qwen3.6-27b",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Subconscious TIM Qwen 3.6 27B",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "subconscious/deepseek-v4-flash-marathon",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "subconscious/deepseek-v4-flash-marathon",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Subconscious DeepSeek V4 Flash Marathon",
        "CLAUDE_CODE_SUBAGENT_MODEL": "subconscious/glm-5.2",
        "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
        "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "3000000",
        "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "OTEL_LOGS_EXPORTER": "otlp",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://api.subconscious.dev/v1/logs",
        "OTEL_EXPORTER_OTLP_HEADERS": "x-api-key=your_key",
        "OTEL_EXPORTER_OTLP_TIMEOUT": "2000",
        "OTEL_LOGS_EXPORT_INTERVAL": "2000"
      }
    }
  },
  "setup": [
    "export ANTHROPIC_BASE_URL=https://api.subconscious.dev",
    "export ANTHROPIC_AUTH_TOKEN=your_key",
    "export ANTHROPIC_MODEL=subconscious/glm-5.2",
    "export ANTHROPIC_SMALL_FAST_MODEL=subconscious/glm-5.2",
    "export ANTHROPIC_DEFAULT_OPUS_MODEL=subconscious/glm-5.2",
    "export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=subconscious/glm-5.2",
    "export ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION='Subconscious default model'",
    "export ANTHROPIC_DEFAULT_SONNET_MODEL=subconscious/tim-qwen3.6-27b",
    "export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=subconscious/tim-qwen3.6-27b",
    "export ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION='Subconscious TIM Qwen 3.6 27B'",
    "export ANTHROPIC_DEFAULT_HAIKU_MODEL=subconscious/deepseek-v4-flash-marathon",
    "export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=subconscious/deepseek-v4-flash-marathon",
    "export ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION='Subconscious DeepSeek V4 Flash Marathon'",
    "export CLAUDE_CODE_SUBAGENT_MODEL=subconscious/glm-5.2",
    "export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=4",
    "export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1",
    "export CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000",
    "export CLAUDE_CODE_MAX_CONTEXT_TOKENS=3000000",
    "export CLAUDE_CODE_ENABLE_TELEMETRY=1",
    "export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
    "export OTEL_LOGS_EXPORTER=otlp",
    "export OTEL_EXPORTER_OTLP_PROTOCOL=http/json",
    "export OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://api.subconscious.dev/v1/logs",
    "export OTEL_EXPORTER_OTLP_HEADERS='x-api-key=your_key'",
    "export OTEL_EXPORTER_OTLP_TIMEOUT=2000",
    "export OTEL_LOGS_EXPORT_INTERVAL=2000",
    "claude"
  ]
}
