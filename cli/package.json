{
  "name": "subconscious-cli",
  "version": "4.0.13",
  "description": "CLI for Subconscious — run Claude Code, Codex, OpenCode, DeepSeek Harness, Cursor, Copilot, and Pi",
  "bin": {
    "subc": "bin/cli.js"
  },
  "scripts": {
    "build:tui": "node scripts/build-tui.js",
    "build:tui:host": "node scripts/build-tui.js --host",
    "test": "node --test",
    "test:tui": "go -C tui test ./...",
    "prepack": "npm run build:tui",
    "prepublishOnly": "node scripts/require-publish-script.js"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subconscious-systems/subconscious.git",
    "directory": "cli"
  },
  "keywords": [
    "subconscious",
    "ai",
    "cli",
    "api-key",
    "authentication",
    "profiles",
    "coding-agent",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "copilot",
    "pi",
    "deepseek-harness",
    "launcher"
  ],
  "author": "Subconscious Systems",
